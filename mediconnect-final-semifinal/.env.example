# Copy to .env and adjust.
PORT=3000
# Local MongoDB (the same string works in MongoDB Compass):
MONGODB_URI=mongodb://127.0.0.1:27017/mediconnect
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mediconnect
# Use a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-change-me
# Origins allowed to call the API from another port (e.g. VS Code Live Server):
CLIENT_ORIGINS=http://localhost:5501,http://127.0.0.1:5501
# Footer "Reset demo data" link (defaults to on in development, off in production)
# ALLOW_DEMO_RESET=true
